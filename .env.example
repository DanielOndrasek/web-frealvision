# Adresa webu. Bez ní má celý nasazený web noindex (viz proxy.ts).
NEXT_PUBLIC_SITE_URL=https://www.f-realvision.cz

# Nemo1 — integrace „Osobní web makléře“, postup v docs/napojeni-nemo1.md
NEMO1_INTEGRATION_ID=
NEMO1_FEED_SECRET=
# Ruční obnovení nabídek přes POST /api/revalidate
NEMO1_REVALIDATE_SECRET=

# Mapa u nabídky (bez klíče se použije OpenStreetMap)
MAPY_API_KEY=

# Záložní e-mail, když se poptávka nedostane do Nemo1 (volitelné)
RESEND_API_KEY=
EMAIL_FROM=
LEAD_NOTIFY_TO=
